<!--app.view.xml의 mvc:XMLView viewName 참고-->
<!--xmlns:mvc, xmlns:f, xmlns:core은 네임스페이스(주소)를 별칭으로 대신 사용. xml은 .사용 불가능 풀네임주소(sap.ui.core.mvc 등) 대신 별칭으로 쓸 수 밖에 없음-->
<mvc:View controllerName="sap.training.exc.controller.overview" xmlns="sap.m" 
xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core">

    <!--제목-->
    <Page title ="제목 고민">

        <!--콘텐츠 영역-->
        <content>

            <!--패널-->
            <!--expandable : 접고 펼치기 가능, expanded : 디폴트 펼쳐져 있음-->
            <Panel expandable="true" expanded="false" headerText="말머리 고민">
                <content>

                    <!--입력폼-->
                    <!--열 레이아웃, 입력 가능-->
                    <f:SimpleForm layout="ColumnLayout" editable="true">

                        <!--<f:SimpleForm> 전용 태그, 툴바(<Toolbar>) 지정용-->
                        <f:toolbar>
                            <!--<f:SimpleForm> 내에서는 <Toolbar>를 반드시 <f:toolbar>와 함께 사용해야 함-->
                            <Toolbar>
                                <content>

                                    <!--우측 배치하도록-->
                                    <ToolbarSpacer/>

                                    <Button icon="sap-icon://create" text="버튼 이름 고민 중"/>
                                </content>
                            </Toolbar>
                        </f:toolbar>
                    </f:SimpleForm>

                    
                </content>
            </Panel>

        </content>

    </Page>
</mvc:View>