<!--app.view.xml의 mvc:XMLView viewName 참고-->
<!--xmlns:mvc, xmlns:f, xmlns:core은 네임스페이스(주소)를 별칭으로 대신 사용. xml은 .사용 불가능 풀네임주소(sap.ui.core.mvc 등) 대신 별칭으로 쓸 수 밖에 없음-->
<mvc:View controllerName="sap.training.exc.controller.overview" xmlns="sap.m" 
xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core">

    <Page title="항공 고객 및 예약 조회">
        <content>
            <Panel expandable="true" expanded="true" headerText="고객 목록">
                <content>
                    <Table id="customerTable" items="{customer>/}" mode="SingleSelectMaster" selectionChange=".onCustomerSelect">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="고객 리스트" level="H2"/>
                                <ToolbarSpacer/>
                                <SearchField placeholder="고객 이름 검색..." search=".onSearch" width="300px"/>
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column><Text text="Customer No"/></Column>
                            <Column><Text text="Name"/></Column>
                            <Column><Text text="City"/></Column>
                            <Column><Text text="Country"/></Column>
                            <Column><Text text="Email"/></Column>
                            <Column><Text text="Discount (%)"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <!-- customer> 모델 접두사 추가 완료 -->
                                    <ObjectIdentifier title="{customer>CustomerNumber}" text="{customer>CustomerGuid}"/>
                                    <Text text="{customer>CustomerName}"/>
                                    <Text text="{customer>City}"/>
                                    <Text text="{customer>Country}"/>
                                    <Text text="{customer>Email}"/>
                                    <ObjectNumber number="{customer>Discount}" unit="%"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Panel>

            <!-- 2. 선택된 고객의 상세 정보 및 예약 내역 패널 (Detail) -->
            <Panel id="bookingPanel" expandable="true" expanded="false" headerText="Selected Customer Bookings (예약 상세 내역)">
                <content>
                    <!-- 고객 상세 심플폼 -->
                    <f:SimpleForm id="customerDetailForm" layout="ColumnLayout" editable="false" title="선택된 고객 프로필">
                        <f:content>
                            <Label text="Form"/>
                            <Text text="{selectedCustomer>/Form}"/>
                            
                            <Label text="Telephone"/>
                            <Text text="{selectedCustomer>/Telephone}"/>
                            
                            <Label text="Street"/>
                            <Text text="{selectedCustomer>/Street}"/>
                        </f:content>
                    </f:SimpleForm>

                    <!-- 예약 내역 테이블 -->
                    <Table id="bookingTable" items="{booking>/}">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="관련 항공권 예약 정보 (UX_Booking)" level="H3"/>
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column><Text text="Booking No"/></Column>
                            <Column><Text text="Airline"/></Column>
                            <Column><Text text="Connection"/></Column>
                            <Column><Text text="Flight Date"/></Column>
                            <Column><Text text="Class"/></Column>
                            <Column><Text text="Payment"/></Column>
                            <Column><Text text="Cancelled"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{booking>BookingNumber}"/>
                                    <Text text="{booking>AirlineID}"/>
                                    <Text text="{booking>ConnectionNumber}"/>
                                    <Text text="{booking>FlightDate}"/>
                                    <Text text="{booking>Class}"/>
                                    <ObjectNumber number="{booking>ForeignCurrencyPayment}" unit="{booking>ForeignCurrency}"/>
                                    <Text text="{booking>IsCancelled}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Panel>

        </content>
    </Page>
</mvc:View>