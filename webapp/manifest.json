{
  "_version": "1.30.0",
  "sap.app": {
    "id": "sap.training.exc",
    "type": "application",
    "title": "Flight Customer & Booking Overview",
    "description": "Customer and Booking Overview Application",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "sap.training.exc.view.app",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.84.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "models": {
      "customer": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "./localService/data/UX_Customer.json"
      },
      "booking": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "./localService/data/UX_Booking.json"
      }
    }
  }
}